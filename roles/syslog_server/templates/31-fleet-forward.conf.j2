# =========================================================================
# 31-fleet-forward.conf — relay firewall syslog to the local Elastic agent
# Managed by roles/syslog_server. Do not edit on the host.
# =========================================================================
# WHY A LOCAL RELAY AND NOT A SECOND DESTINATION ON THE FIREWALL
# --------------------------------------------------------------
# The firewalls were briefly configured to dual-send: :514 here for the
# /var/log/remote/ store, and :{{ so_pfsense_syslog_port }} here for the
# Elastic pfSense integration. pfSense honoured only ONE of them once both
# entries pointed at the same address -- proved 2026-09-10 by tcpdump on
# this host: steady traffic to :514, zero packets to :{{ so_pfsense_syslog_port }}.
# The same dual-send DID work while the second target was a different host,
# so pfSense appears to collapse remote syslog entries by address.
#
# So the firewalls send ONCE, and rsyslog fans out locally. Fewer moving
# parts than the dual-send, and independent of pfSense's behaviour.
#
# ATTRIBUTION SURVIVES. The objection to relaying is that rsyslog rewrites
# the syslog header, so every sender arrives as this host -- and that header
# is exactly what the pfSense ingest pipeline reads. RSYSLOG_ForwardFormat
# preserves the ORIGINAL hostname and timestamp, so each firewall keeps its
# identity. That objection applies to relaying somewhere else, not to
# fanning out on the box that already received the message.
#
# NO `stop`: messages continue to the per-host file rules in 30-remote.conf.
# The store keeps everything it has today.
# MATCH ON SOURCE IP, NOT HOSTNAME
# ---------------------------------
# pfSense does not send a resolvable hostname, so rsyslog falls back to the
# source address: /var/log/remote/ on this host contains 172.16.0.9,
# 172.16.0.18, 172.16.0.25 and 172.16.0.50 where the routers appear by name.
# A `$hostname == pp-ot-firewall` rule therefore matched nothing at all
# (2026-09-10) and the dataset was never created.
#
# Note pp-internal-firewall sends from TWO addresses (.18 WAN_EDGE and .25
# INTERNAL), so matching one identity per firewall was never going to work
# either. Every pfsense_interfaces entry is enumerated from inventory, so
# adding an interface or a firewall keeps this in step automatically.
{% set ns = namespace(ips=[]) %}
{% for h in groups['pfsense'] | default([]) %}
{%   for i in hostvars[h].pfsense_interfaces | default([]) %}
{%     if i.ipv4_address is defined %}{% set ns.ips = ns.ips + [i.ipv4_address] %}{% endif %}
{%   endfor %}
{% endfor %}
{% if ns.ips | length > 0 %}
if ({% for ip in ns.ips %}$fromhost-ip == '{{ ip }}'{% if not loop.last %} or {% endif %}{% endfor %}) then {
    action(type="omfwd"
           target="127.0.0.1"
           port="{{ so_pfsense_syslog_port }}"
           protocol="udp"
           template="RSYSLOG_ForwardFormat")
}
{% else %}
# No pfsense_interfaces found in inventory; nothing to relay.
{% endif %}
