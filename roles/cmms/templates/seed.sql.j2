/* ---------- work-order history ----------
   RAND is seeded once so a rebuild reproduces this table exactly. The same
   determinism convention billing_site uses with random.Random(42). */
DECLARE @i INT = 1, @n INT = 420;
DECLARE @seeded FLOAT = RAND({{ cmms_seed }});
DECLARE @assets INT = (SELECT COUNT(*) FROM dbo.assets);
DECLARE @techs  INT = (SELECT COUNT(*) FROM dbo.technicians);

WHILE @i <= @n
BEGIN
    DECLARE @aid INT = (SELECT MIN(asset_id) FROM dbo.assets) + CAST(RAND() * @assets AS INT);
    DECLARE @tid INT = (SELECT MIN(tech_id)  FROM dbo.technicians) + CAST(RAND() * @techs AS INT);
    DECLARE @age INT = CAST(RAND() * 400 AS INT);
    DECLARE @r   FLOAT = RAND();
    DECLARE @wtype VARCHAR(16) = CASE WHEN @r < 0.62 THEN 'PM'
                                      WHEN @r < 0.92 THEN 'Corrective'
                                      ELSE 'Emergency' END;
    DECLARE @open DATETIME2 = DATEADD(day, -@age, GETDATE());
    DECLARE @done BIT = CASE WHEN @age > 21 THEN 1 ELSE CASE WHEN RAND() < 0.55 THEN 1 ELSE 0 END END;

    INSERT INTO dbo.work_orders
        (wo_number, asset_id, wo_type, priority, status, opened_on, due_on, closed_on, assigned_to, description, labor_hours)
    VALUES (
        'WO-' + RIGHT('00000' + CAST(100000 + @i AS VARCHAR(6)), 6),
        @aid, @wtype,
        CASE @wtype WHEN 'Emergency' THEN 1 WHEN 'Corrective' THEN 2 + CAST(RAND()*2 AS INT) ELSE 3 + CAST(RAND()*2 AS INT) END,
        CASE WHEN @done = 1 THEN 'Closed' ELSE CASE WHEN RAND() < 0.4 THEN 'In Progress' ELSE 'Open' END END,
        @open,
        DATEADD(day, 7 + CAST(RAND()*21 AS INT), @open),
        CASE WHEN @done = 1 THEN DATEADD(day, 1 + CAST(RAND()*14 AS INT), @open) ELSE NULL END,
        @tid,
        CASE @wtype
            WHEN 'PM'         THEN 'Routine preventive maintenance per schedule.'
            WHEN 'Corrective' THEN 'Corrective repair raised from operator round / condition monitoring.'
            ELSE 'Emergency repair — equipment removed from service.'
        END,
        CASE WHEN @done = 1 THEN CAST(ROUND(RAND()*16 + 0.5, 1) AS DECIMAL(6,1)) ELSE NULL END
    );
    SET @i = @i + 1;
END
GO

PRINT 'CMMS seed complete.';
